# Скопируйте в .env. Файл .env в git не попадает.

# Папка с делами (репозиторий red-thread-secret рядом с этим)
CASES_DIR=../red-thread-secret

# Код ведущего для экрана (домашний режим)
HOST_CODE=0228

# Ссылки проекта (необязательно, только https)
TELEGRAM_URL=
DONATE_URL=

# Ключи генераторов — нужны только для инструментов в tools/
# ElevenLabs: elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=
# GigaChat: developers.sber.ru → проект → ключ авторизации (base64 от Client ID:Client Secret)
GIGACHAT_AUTH_KEY=
