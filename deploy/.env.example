# Адрес сайта для Caddy.
#   домен (A-запись указывает на сервер) — HTTPS получится сам: DOMAIN=krasnaya-nit.ru
#   пока домена нет — только HTTP по IP:                      DOMAIN=http://176.57.218.253
DOMAIN=example.ru

# Папка с делами относительно deploy/ (репозиторий red-thread-secret)
CASES_DIR=../../red-thread-secret

# За Cloudflare адрес игрока приходит в cf-connecting-ip; без Cloudflare оставьте x-forwarded-for
REAL_IP_HEADER=x-forwarded-for

# Ссылки проекта (только https): канал в Telegram и страница доната
TELEGRAM_URL=
DONATE_URL=

# Сколько комнат одновременно (2 ядра и 4 ГБ спокойно держат сотни)
MAX_ROOMS=300
